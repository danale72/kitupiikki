  'maaritys/maksutapamuokkausdlg.ui',
  'arkisto/tuloverodialog.ui',
  'kierto/kiertomuokkausdlg.ui',
  'maaritys/bannerdialog.ui',
  'aloitussivu/debugtiedotdlg.ui',
)

qrc_files = files(
  'rekisteri/rekisteri.qrc',
  'sqlite/sqlite.qrc',
  'postgres/postgres.qrc',
  'tilinpaatoseditori/tilinpaatos.qrc',
  'toimisto/qrc/web.qrc',
  'tr/tr.qrc',
  'tilikartat/tilikartat.qrc',
  'pic/pic.qrc',
  'aloitussivu/qrc/aloitus.qrc',
  'arkistoija/arkisto.qrc',
  'laskutus/lasku.qrc',
)

# File lists above are the former sources.pri + pdftuonti.pri contents.
# main.cpp is the executable, not part of the static library.

kitsas_inc = include_directories('.')
kitsas_build_dir = meson.current_build_dir().replace('\\', '/')

zip_dep = dependency('libzip', required: get_option('use_zip'))
core_deps = [qt_dep] + qt_extra_deps
core_cpp_args = []
moc_args = ['-I' + kitsas_build_dir]
if zip_dep.found()
  core_deps += zip_dep
  core_cpp_args += '-DUSE_ZIPLIB'
  moc_args += '-DUSE_ZIPLIB'
endif
if host_machine.system() == 'windows'
  core_deps += meson.get_compiler('cpp').find_library('bcrypt')
endif

ui_headers = qt6.compile_ui(
  sources: ui_files,
  method: qt_method,
)

# moc parses headers that include generated ui_*.h, so uic has to finish first.
ui_stamp = custom_target(
  'ui-stamp',
  input: ui_headers,
  output: 'ui-stamp.txt',
  command: [py, '-c', 'import sys; open(sys.argv[1], "w", encoding="utf-8").write("ok")', '@OUTPUT@'],
  build_by_default: true,
)

moc_files = qt6.compile_moc(
  headers: moc_headers,
  include_directories: kitsas_inc,
  dependencies: [qt_dep, declare_dependency(sources: ui_stamp)] + qt_extra_deps,
  extra_args: moc_args,
  method: qt_method,
)

qrc_cpp = qt6.compile_resources(
  sources: qrc_files,
  method: qt_method,
)

# kitsas_*.qm come from the .ts files. qtbase_*.qm live in the Qt SDK.
# compile_resources() cannot consume a qrc produced at build time, so the
# qrc is written at configure time and rcc runs only after lrelease.
lrelease = find_program('lrelease', 'lrelease-qt6', dirs: qt_tool_dirs)
rcc = find_program('rcc', 'rcc-qt6', dirs: qt_tool_dirs)
kitsas_en_qm = custom_target(
  'kitsas-en-qm',
  input: 'tr/kitsas_en.ts',
  output: 'kitsas_en.qm',
  command: [lrelease, '@INPUT@', '-qm', '@OUTPUT@'],
  build_by_default: true,
)
kitsas_sv_qm = custom_target(
  'kitsas-sv-qm',
  input: 'tr/kitsas_sv.ts',
  output: 'kitsas_sv.qm',
  command: [lrelease, '@INPUT@', '-qm', '@OUTPUT@'],
  build_by_default: true,
)
tr_qm_qrc = configure_file(
  input: 'tr_qm.qrc.in',
  output: 'tr_qm.qrc',
  configuration: {
    'KITSAS_EN': kitsas_build_dir / 'kitsas_en.qm',
    'KITSAS_SV': kitsas_build_dir / 'kitsas_sv.qm',
    'QTBASE_FI': qtbase_fi_qm.replace('\\', '/'),
    'QTBASE_SV': qtbase_sv_qm.replace('\\', '/'),
  },
)
tr_qm_cpp = custom_target(
  'tr-qm-rcc',
  input: [kitsas_en_qm, kitsas_sv_qm],
  output: 'qrc_tr_qm.cpp',
  command: [rcc, '-name', 'tr_qm', '-o', '@OUTPUT@', tr_qm_qrc],
  build_by_default: true,
)

kitsas_core = static_library(
  'kitsas_core',
  core_sources,
  moc_files,
  ui_headers,
  qrc_cpp,
  tr_qm_cpp,
  include_directories: kitsas_inc,
  dependencies: core_deps,
  cpp_args: core_cpp_args,
)

# link_whole keeps Qt resource initializers, which a static library would
# otherwise drop. ui_headers gives dependents the generated ui_*.h path.
kitsas_dep = declare_dependency(
  link_whole: kitsas_core,
  include_directories: kitsas_inc,
  dependencies: core_deps,
  sources: ui_headers,
)

app_sources = []
app_deps = []
if host_machine.system() == 'windows'
  icon_path = (meson.current_source_dir() / 'kitsas.ico').replace('\\', '/')
  app_rc = configure_file(
    input: 'kiswaspg.rc.in',
    output: 'kiswaspg.rc',
    configuration: {'ICON_PATH': icon_path},
  )
  app_sources += import('windows').compile_resources(app_rc)
  app_deps += dependency('qt6', modules: ['Core'], method: qt_method, main: true)
endif
